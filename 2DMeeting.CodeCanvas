					"inputDataExample": "{\n  \"myWelcomePackage\": {\n    \"id\": \"_some_socket_id_abc123\",\n    \"coordinates\": {\n      \"x\": \"780px\",\n      \"y\": \"450px\"\n    }\n  },\n  \"existingUsers\": [\n    {\n      \"id\": \"_some_socket_id_def456\",\n      \"coordinates\": {\n        \"x\": \"123px\",\n        \"y\": \"800px\"\n      }\n    }\n  ]\n}",
					"outputDataExample": "{\n  \"peers\": [\n    {\n      \"peerID\": \"_some_socket_id_def456\",\n      \"peer\": \"[WebRTCPeerObject]\"\n    }\n  ]\n}"
				}
			],
			"description": "<ul><li>The application organizes meetings into isolated sessions called 'rooms'</li><li>When a user navigates to the root URL, a unique room ID is generated using UUID, and they are redirected to a new room</li><li>Other users can join the same meeting by navigating to the URL containing the specific room ID</li><li>The server manages room state, ensuring only participants in the same room can interact</li></ul>",
			"simulationNodesAndEdges": {
