						]
					},
					"inputDataExample": "{\"newUserID\": \"new_user_socket_id\", \"signal\": {\"type\": \"answer\", \"sdp\": \"...\"}}",
					"outputDataExample": "{\"newUserID\": \"new_user_socket_id\", \"signal\": {\"type\": \"answer\", \"sdp\": \"...\"}}"
				},
				{
					"simStepId": "f934a346-1f0e-42d7-a92b-3ab11ec9728e",
					"diagramNodeId": "7d9af7ba-72ca-412d-b4aa-916eb21a5315",
					"simStepLabel": "11. Server: Relay Answer Signal",
					"simStepDescription": "The server receives the 'returning-signal-to-new-users' event and relays the answer signal to the new user via a 'receiving-returned-signal-from-existing-user' event.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "44",
						"endLine": "52",
						"relevantVariables": [
							"io.to",
							"emit(\"receiving-returned-signal-from-existing-user\")"
						]
					},
					"inputDataExample": "{\"newUserID\": \"new_user_socket_id\", \"signal\": {\"type\": \"answer\", \"sdp\": \"...\"}}",
					"outputDataExample": "{\"signal\": {\"type\": \"answer\", \"sdp\": \"...\"}, \"id\": \"existing_user_socket_id\"}"
				},
				{
					"simStepId": "04fa5a71-90e8-4634-8815-f4f28aa8c28f",
					"diagramNodeId": "8c5104c3-ab7e-4ec0-9ecd-7aeea40ee2cc",
					"simStepLabel": "12. Server -> Client (New): Forward Answer",
					"simStepDescription": "The server emits the 'receiving-returned-signal-from-existing-user' event to the new user, containing the existing user's ID and the crucial WebRTC answer signal.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "45",
						"endLine": "51",
						"relevantVariables": [
							"io.to(payload.newUserID).emit"
						]
					},
					"inputDataExample": "{\"signal\": {\"type\": \"answer\", \"sdp\": \"...\"}, \"id\": \"existing_user_socket_id\"}",
					"outputDataExample": "{\"signal\": {\"type\": \"answer\", \"sdp\": \"...\"}, \"id\": \"existing_user_socket_id\"}"
				},
				{
					"simStepId": "451f5c18-0e73-4a9d-b438-58516db8a712",
					"diagramNodeId": "6308243f-b46e-47a1-947f-cfb9cc2d63bc",
					"simStepLabel": "13. Client (New): Finalize Connection",
					"simStepDescription": "The new user's client receives the answer signal and passes it to the corresponding `simple-peer` instance. This completes the WebRTC handshake, and a direct P2P connection is now established.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "231",
						"endLine": "240",
						"relevantVariables": [
							"peer",
							"peer.signal(payload.signal)"
						]
					},
					"inputDataExample": "{\"signal\": {\"type\": \"answer\", \"sdp\": \"...\"}, \"id\": \"existing_user_socket_id\"}",
					"outputDataExample": "{\"status\": \"P2P connection established\"}"
				},
				{
					"simStepId": "be2c58be-f1a8-46e0-8ab2-6a362861134f",
					"diagramNodeId": "e996f4a6-bc63-4746-9571-6884d1feb05b",
					"simStepLabel": "14. P2P: Media Stream Transmission",
					"simStepDescription": "With the connection established, video and audio data flows directly between the two clients' browsers as a MediaStream, bypassing the server.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "110",
						"endLine": "112",
						"relevantVariables": [
							"props.peerObj.peer.on(\"stream\")"
						]
					},
					"inputDataExample": "{\"stream\": \"MediaStream from Peer A\"}",
					"outputDataExample": "{\"stream\": \"MediaStream from Peer A\"}"
				},
				{
					"simStepId": "97019558-c9c8-40c1-8790-d7b91e1c8273",
					"diagramNodeId": "92da4c5a-cd26-4b23-ad9c-1d4226318648",
					"simStepLabel": "15. Client: Render Remote Video",
					"simStepDescription": "Both clients listen for the 'stream' event from the peer object. When a remote stream is received, it's attached to the `srcObject` of a `<video>` element, making the other user visible and audible.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "110",
						"endLine": "112",
						"relevantVariables": [
							"ref.current.srcObject",
							"stream"
						]
					},
					"inputDataExample": "{\"stream\": \"MediaStream from remote peer\"}",
					"outputDataExample": "{\"ui_state\": \"<video> element is now playing the remote stream\"}"
				}
			],
			"description": "<ul><li><em> The application's primary function is to enable multi-user video and audio calls</li><li></em> It uses the browser's <code>navigator</li><li>mediaDevices</li><li>getUserMedia</code> API to access the user's camera and microphone</li><li><em> Peer-to-peer connections are established using the <code>simple-peer</code> library (a WebRTC wrapper), allowing direct media streaming between users to reduce server load</li><li></em> The backend (<code>server</li><li>js</code>) facilitates the initial WebRTC connection setup (signaling) between clients using Socket</li><li>IO</li></ul>",
			"simulationNodesAndEdges": {
