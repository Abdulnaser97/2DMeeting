							"initialCoordinates",
							"newPeer"
						]
					},
					"inputDataExample": "{\n  \"payload\": {\n    \"roomID\": \"a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d\",\n    \"initialCoordinates\": {\n      \"x\": \"780px\",\n      \"y\": \"450px\"\n    }\n  }\n}",
					"outputDataExample": "{\n  \"newPeer\": {\n    \"id\": \"_some_socket_id_abc123\",\n    \"coordinates\": {\n      \"x\": \"780px\",\n      \"y\": \"450px\"\n    }\n  }\n}"
				},
