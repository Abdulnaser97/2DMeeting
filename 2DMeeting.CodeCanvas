							"props.peerObj",
							"StyledNode",
							"props.peerObj.peer.config.coordinates"
						]
					},
					"inputDataExample": "{\"peerObj\": {\"peerID\": \"_24v-a1b2c3d4e5f\", \"peer\": {\"config\": {\"coordinates\": {\"x\": 753, \"y\": 421}}}}}",
					"outputDataExample": "{\"peerObj\": {\"peerID\": \"_24v-a1b2c3d4e5f\", \"peer\": {\"config\": {\"coordinates\": {\"x\": 753, \"y\": 421}}}}}"
				},
				{
					"simStepId": "16a4cedf-0c89-48a0-b2f0-8ac4108fd3be",
					"diagramNodeId": "9fe45e29-d23a-4a98-b396-cbc01014db80",
					"simStepLabel": "Render Video Node with Positional Props",
					"simStepDescription": "The `Video` component receives the peer data via props. It then renders a `StyledNode` component, extracting the `x` and `y` coordinates from the props and passing them to the `left` and `top` props of the `StyledNode`.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "117",
						"endLine": "121",
