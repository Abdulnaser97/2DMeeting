					},
					"inputDataExample": "{\n  \"newPeer\": {\n    \"id\": \"_some_socket_id_abc123\",\n    \"coordinates\": {\n      \"x\": \"780px\",\n      \"y\": \"450px\"\n    }\n  }\n}",
					"outputDataExample": "{\n  \"newPeer\": {\n    \"id\": \"_some_socket_id_abc123\",\n    \"coordinates\": {\n      \"x\": \"780px\",\n      \"y\": \"450px\"\n    }\n  }\n}"
				},
				{
					"simStepId": "272e24a0-6a26-4583-86ce-a1670fddbac6",
					"diagramNodeId": "0f17f173-f7ae-4554-8309-760c9dc04d62",
					"simStepLabel": "Server Updates Room State",
					"simStepDescription": "The server adds the new user to its in-memory 'users' object, keyed by the room ID. If the room doesn't exist, it's created. The server also maps the client's socket ID to the room ID for future lookups (like on disconnect).",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "20",
						"endLine": "26",
						"relevantVariables": [
							"users",
							"roomID",
							"newPeer",
							"socketToRoom"
						]
					},
					"inputDataExample": "{\n  \"roomID\": \"a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d\",\n  \"newPeer\": {\n    \"id\": \"_some_socket_id_abc123\",\n    \"coordinates\": {\n      \"x\": \"780px\",\n      \"y\": \"450px\"\n    }\n  }\n}",
					"outputDataExample": "{\n  \"users\": {\n    \"a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d\": [\n      {\n        \"id\": \"_some_socket_id_abc123\",\n        \"coordinates\": {\n          \"x\": \"780px\",\n          \"y\": \"450px\"\n        }\n      }\n    ]\n  }\n}"
				},
				{
					"simStepId": "a542d335-b12f-4a5a-a4fc-51b9072056cb",
					"diagramNodeId": "ea819186-991f-49e1-9161-73511cb492e4",
					"simStepLabel": "Server Sends List of Existing Users",
					"simStepDescription": "The server gets the list of all users already in the room (excluding the newly joined user) and sends it to the new user via an 'existing-users' event. For the first user, this list is empty. For subsequent users, it contains the peers already in the room.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "28",
						"endLine": "33",
