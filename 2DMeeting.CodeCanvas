							"io.to",
							"emit(\"user-joined\")"
						]
					},
					"inputDataExample": "{\"existingUserID\": \"existing_user_socket_id\", \"myID\": \"new_user_socket_id\", \"signal\": {\"type\": \"offer\", \"sdp\": \"...\"}, \"myCoordinates\": {\"x\": 345, \"y\": 678}}",
					"outputDataExample": "{\"signal\": {\"type\": \"offer\", \"sdp\": \"...\"}, \"newUserID\": \"new_user_socket_id\", \"coordinates\": {\"x\": 345, \"y\": 678}}"
				},
