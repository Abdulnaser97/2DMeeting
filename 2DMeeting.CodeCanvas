					"diagramNodeId": "5a164063-9a04-4b6c-a167-c3c7fee08dbe",
					"simStepLabel": "Server: Forward Offer Signal",
					"simStepDescription": "The server receives the `stream-to-existing-users` event. It acts as a signaling server, forwarding the offer signal to the specified existing user via a `user-joined` event.",
