							"props.peerObj.peer.config.coordinates.x"
						]
					},
					"inputDataExample": "{\"peerObj\": {\"peerID\": \"_24v-a1b2c3d4e5f\", \"peer\": {\"config\": {\"coordinates\": {\"x\": 753, \"y\": 421}}}}}",
					"outputDataExample": "<StyledNode id=\"_24v-a1b2c3d4e5f\" top={421} left={753} />"
				},
				{
					"simStepId": "a774db09-63cb-41fa-8be8-3f46afbd67c9",
					"diagramNodeId": "",
					"simStepLabel": "Translate Props to CSS for Positioning",
					"simStepDescription": "The `StyledNode` (a styled-component) uses the `top` and `left` props it received to generate the final CSS rules. It sets `position: absolute` and injects the prop values into the `top` and `left` CSS properties, which the browser then uses to render the element in the correct location on the page.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "32",
						"endLine": "43",
						"relevantVariables": [
							"StyledNode",
							"styled.div",
							"position: absolute",
							"props.top",
							"props.left"
						]
					},
					"inputDataExample": "{\"top\": 421, \"left\": 753}",
					"outputDataExample": "{\"css\": \"position: absolute; top: 421px; left: 753px;\"}"
				}
			],
			"description": "<ul><li><em> Unlike traditional grid-based video calls, participants are represented as circular video nodes within a 2D virtual space</li><li></em> Each user is assigned random initial X and Y coordinates upon joining, positioning their video feed on a large virtual 'stage'</li><li><em> The front-end (<code>Room</li><li>js</code>) uses CSS (<code>position: absolute</code>) to place each participant's <code>StyledNode</code> component according to their coordinates</li><li></em> This spatial layout forms the foundation for proximity-based interactions or simply a more engaging meeting experience</li></ul>",
			"simulationNodesAndEdges": {
				"1bf7e9a1-f09f-4eed-a097-06e7ddf6de3b": {
					"simStepIds": [
						"b883cfd8-0e36-4f81-9732-e56403598fa0"
