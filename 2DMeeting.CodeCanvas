		"bdbdb355-20bc-472e-91b9-e0a2bf62f1cb": {
			"path": "bdbdb355-20bc-472e-91b9-e0a2bf62f1cb",
			"cellName": "Generate Initial Coordinates - Room.js:L46-52",
			"cellId": "bdbdb355-20bc-472e-91b9-e0a2bf62f1cb",
			"visible": true,
			"parentCellId": "63df3399-6dec-4a79-9180-1feeae987272"
		},
		"client/src/routes/Room.js-simstep-27bcdb0a-eef4-47ed-97fb-0f8ef7219efd": {
			"path": "client/src/routes/Room.js-simstep-27bcdb0a-eef4-47ed-97fb-0f8ef7219efd",
			"fileName": "Room.js",
			"wiki": "Upon entering a room, the client's browser calls the `randomCoordinates` function to generate a random (x, y) position for the user's avatar within the 2D stage.",
			"cellName": "Generate Initial Coordinates - Room.js:L46-52",
			"cellId": "bdbdb355-20bc-472e-91b9-e0a2bf62f1cb",
			"visible": true,
			"startLine": 46,
			"endLine": 52,
			"parentCellId": "63df3399-6dec-4a79-9180-1feeae987272",
			"parentPath": "client/src/routes/Room.js"
		},
		"49394469-e8d8-4c7a-934a-3f7eaff2f2e8": {
			"path": "49394469-e8d8-4c7a-934a-3f7eaff2f2e8",
			"cellName": "Server Receives 'join-room' Event - server.js:L14-18",
			"cellId": "49394469-e8d8-4c7a-934a-3f7eaff2f2e8",
			"visible": true,
			"parentCellId": "c31af4f6-ab55-42b7-bdf4-c3bae3240f04"
		},
		"server.js-simstep-3c61b93d-7b6b-40e4-9844-b10642cec363": {
			"path": "server.js-simstep-3c61b93d-7b6b-40e4-9844-b10642cec363",
			"fileName": "server.js",
			"wiki": "The server's WebSocket listener receives the 'join-room' event. It extracts the payload, creates a new peer object with the client's socket ID and coordinates, and prepares a welcome package.",
			"cellName": "Server Receives 'join-room' Event - server.js:L14-18",
			"cellId": "49394469-e8d8-4c7a-934a-3f7eaff2f2e8",
			"visible": true,
			"startLine": 14,
			"endLine": 18,
			"parentCellId": "c31af4f6-ab55-42b7-bdf4-c3bae3240f04",
			"parentPath": "server.js"
		},
		"bedcf977-144c-4be7-94e5-4d8fb6466ac9": {
			"path": "bedcf977-144c-4be7-94e5-4d8fb6466ac9",
			"cellName": "Client Processes Welcome Package - Room.js:L150-156",
			"cellId": "bedcf977-144c-4be7-94e5-4d8fb6466ac9",
			"visible": true,
			"parentCellId": "63df3399-6dec-4a79-9180-1feeae987272"
		},
		"client/src/routes/Room.js-simstep-8557a1c4-29db-4fc4-8f87-d0f8d375c892": {
			"path": "client/src/routes/Room.js-simstep-8557a1c4-29db-4fc4-8f87-d0f8d375c892",
			"fileName": "Room.js",
			"wiki": "The client listens for the 'your-welcome-package' event. Upon receipt, it updates its internal state (`myPeer`) with its ID, the confirmed coordinates, and its local media stream.",
			"cellName": "Client Processes Welcome Package - Room.js:L150-156",
			"cellId": "bedcf977-144c-4be7-94e5-4d8fb6466ac9",
			"visible": true,
			"startLine": 150,
			"endLine": 156,
			"parentCellId": "63df3399-6dec-4a79-9180-1feeae987272",
			"parentPath": "client/src/routes/Room.js"
		},
		"d6de0b12-765c-41fb-9e8e-a136b0f4eae6": {
			"path": "d6de0b12-765c-41fb-9e8e-a136b0f4eae6",
			"cellName": "Render User's Own Video Avatar - Room.js:L94-105",
			"cellId": "d6de0b12-765c-41fb-9e8e-a136b0f4eae6",
			"visible": true,
			"parentCellId": "63df3399-6dec-4a79-9180-1feeae987272"
		},
		"client/src/routes/Room.js-simstep-b3d4474a-5e9c-4eb4-ab1b-920c69158c01": {
			"path": "client/src/routes/Room.js-simstep-b3d4474a-5e9c-4eb4-ab1b-920c69158c01",
			"fileName": "Room.js",
			"wiki": "The `MyVideo` component receives the `peer` prop. It constructs a `StyledNode` component, passing the coordinates from the prop to `StyledNode`'s `top` and `left` props.",
			"cellName": "Render User's Own Video Avatar - Room.js:L94-105",
			"cellId": "d6de0b12-765c-41fb-9e8e-a136b0f4eae6",
			"visible": true,
			"startLine": 94,
			"endLine": 105,
			"parentCellId": "63df3399-6dec-4a79-9180-1feeae987272",
			"parentPath": "client/src/routes/Room.js"
		},
		"462e9ac4-3f28-4ad5-858a-e89a501192b5": {
			"path": "462e9ac4-3f28-4ad5-858a-e89a501192b5",
			"cellName": "Apply Positional Styles via CSS - Room.js:L34-43",
			"cellId": "462e9ac4-3f28-4ad5-858a-e89a501192b5",
			"visible": true,
			"parentCellId": "63df3399-6dec-4a79-9180-1feeae987272"
		},
		"client/src/routes/Room.js-simstep-2af15707-a112-4950-9b72-6a37eb472a6c": {
			"path": "client/src/routes/Room.js-simstep-2af15707-a112-4950-9b72-6a37eb472a6c",
			"fileName": "Room.js",
			"wiki": "The `StyledNode` component, a styled-component, interprets the `top` and `left` props and injects them into its CSS template, applying `position: absolute` and setting the `top` and `left` style properties to position the avatar on the screen.",
			"cellName": "Apply Positional Styles via CSS - Room.js:L34-43",
			"cellId": "462e9ac4-3f28-4ad5-858a-e89a501192b5",
			"visible": true,
			"startLine": 34,
			"endLine": 43,
			"parentCellId": "63df3399-6dec-4a79-9180-1feeae987272",
			"parentPath": "client/src/routes/Room.js"
		},
