		"Joining and Participating in a Shared Virtual Room": {
			"name": "Joining and Participating in a Shared Virtual Room",
			"simSteps": [
				{
					"simStepId": "aaa1772b-f2c4-496f-be72-6bba3b8e4988",
					"diagramNodeId": "8921f583-7985-482d-aa81-532c0ed7ec24",
					"simStepLabel": "Route Matching",
					"simStepDescription": "A user navigates to a URL with a specific room ID, such as '/room/tech-talk-123'. The React Router in the client application matches this path and renders the `Room` component.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/App.js",
						"startLine": "11",
						"endLine": "11",
						"relevantVariables": [
							"BrowserRouter",
							"Route",
							"Room"
						]
					},
					"inputDataExample": "{\"url\": \"/room/tech-talk-123\"}",
					"outputDataExample": "{\"component\": \"Room\", \"props\": {\"match\": {\"params\": {\"roomID\": \"tech-talk-123\"}}}}"
				},
				{
					"simStepId": "a180c2f1-31f8-4c7f-96b2-560736d79fa8",
					"diagramNodeId": "1616f420-472f-447c-8f28-1817681e9338",
					"simStepLabel": "Room ID Propagation",
					"simStepDescription": "React Router passes the `roomID` extracted from the URL as a prop to the `Room` component, making it available for the component to use.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "140",
						"endLine": "140",
						"relevantVariables": [
							"props.match.params.roomID"
						]
					},
					"inputDataExample": "{\"match\": {\"params\": {\"roomID\": \"tech-talk-123\"}}}",
					"outputDataExample": "{\"match\": {\"params\": {\"roomID\": \"tech-talk-123\"}}}"
				},
				{
					"simStepId": "acae6d4c-c22c-4669-92b8-2d810b43bc14",
					"diagramNodeId": "dba46854-9aa9-4608-b8f2-ff4b1949b816",
					"simStepLabel": "Client Initiates Connection",
					"simStepDescription": "The `Room` component mounts and its `useEffect` hook is executed. It establishes a connection to the Socket.IO server, captures the user's camera and microphone, and emits a `join-room` event containing the room ID and randomly generated initial coordinates.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "143",
						"endLine": "147",
						"relevantVariables": [
							"useEffect",
							"io.connect",
							"socketRef.current.emit",
							"roomID",
							"initialCoordinates"
						]
					},
					"inputDataExample": "{\"roomID\": \"tech-talk-123\"}",
					"outputDataExample": "{\"event\": \"join-room\", \"payload\": {\"roomID\": \"tech-talk-123\", \"initialCoordinates\": {\"x\": \"250px\", \"y\": \"600px\"}}}"
				},
				{
					"simStepId": "af6c212c-8044-4a4f-a373-8b50270ae782",
					"diagramNodeId": "7500fe03-487b-4da4-8bdf-16ff7b079f5c",
					"simStepLabel": "Client -> Server: 'join-room' Event",
					"simStepDescription": "The client sends the `join-room` event over the WebSocket connection to the server, signaling its intent to join a specific room.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "147",
						"endLine": "147",
						"relevantVariables": [
							"socketRef.current.emit"
						]
					},
					"inputDataExample": "{\"roomID\": \"tech-talk-123\", \"initialCoordinates\": {\"x\": \"250px\", \"y\": \"600px\"}}",
					"outputDataExample": "{\"roomID\": \"tech-talk-123\", \"initialCoordinates\": {\"x\": \"250px\", \"y\": \"600px\"}}"
				},
				{
					"simStepId": "764a43e0-1ba7-45f9-b907-da999ab80f71",
					"diagramNodeId": "6a1d6490-ca18-446a-9eea-5a30cbde051e",
					"simStepLabel": "Server Handles New User and Gets Room Roster",
					"simStepDescription": "The server's `connection` handler receives the `join-room` event. It creates a `newPeer` object for the new user, adds them to the in-memory `users` store for the specified room, and then filters the store to get a list of all other users already present.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "13",
						"endLine": "31",
						"relevantVariables": [
							"socket.on",
							"users",
							"socketToRoom",
							"usersInThisRoom"
						]
					},
					"inputDataExample": "{\"roomID\": \"tech-talk-123\", \"initialCoordinates\": {\"x\": \"250px\", \"y\": \"600px\"}}",
					"outputDataExample": "{\"usersInThisRoom\": [{\"id\": \"EXISTING_USER_SOCKET_ID\", \"coordinates\": {\"x\": \"100px\", \"y\": \"200px\"}}]}"
				},
				{
					"simStepId": "766ef4c7-b1b7-482a-9657-47f559ffb8a9",
					"diagramNodeId": "9d5a362c-4a5b-4b60-b09f-6d2c4f13addd",
					"simStepLabel": "Server -> Client: 'existing-users' Event",
					"simStepDescription": "The server sends the list of existing users back to the newly joined client, allowing the new client to know who to establish peer connections with.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "33",
						"endLine": "33",
						"relevantVariables": [
							"socket.emit"
						]
					},
					"inputDataExample": "[{\"id\": \"EXISTING_USER_SOCKET_ID\", \"coordinates\": {\"x\": \"100px\", \"y\": \"200px\"}}]",
					"outputDataExample": "[{\"id\": \"EXISTING_USER_SOCKET_ID\", \"coordinates\": {\"x\": \"100px\", \"y\": \"200px\"}}]"
				},
				{
					"simStepId": "270b5313-ffca-4afe-a871-9656691087ea",
					"diagramNodeId": "c25511fb-d13d-4eeb-a90a-88cc9df2f369",
					"simStepLabel": "Client Creates Peer Connections",
					"simStepDescription": "The new client's listener for the `existing-users` event fires. It iterates through the received list of users and calls the `createMyPeer` function for each one to initiate a WebRTC peer-to-peer connection.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "156",
						"endLine": "161",
						"relevantVariables": [
							"socketRef.current.on",
							"users",
							"createMyPeer"
						]
					},
					"inputDataExample": "[{\"id\": \"EXISTING_USER_SOCKET_ID\", \"coordinates\": {\"x\": \"100px\", \"y\": \"200px\"}}]",
					"outputDataExample": "{\"status\": \"Creating Peer object for user EXISTING_USER_SOCKET_ID\"}"
				},
				{
					"simStepId": "0ca9edba-ef9a-41ee-a45b-200f9c28373c",
					"diagramNodeId": "ed464a91-add3-4467-81a4-cbccbd00edb1",
					"simStepLabel": "Client -> Server: WebRTC Signal via 'stream-to-existing-users'",
					"simStepDescription": "The newly created `Peer` object generates a connection signal (part of the WebRTC handshake). The client sends this signal to the server inside a `stream-to-existing-users` event, specifying which existing user the signal is for.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "239",
						"endLine": "246",
						"relevantVariables": [
							"peer.on",
							"socketRef.current.emit"
						]
					},
					"inputDataExample": "{\"existingUserID\": \"EXISTING_USER_SOCKET_ID\", \"myID\": \"NEW_USER_SOCKET_ID\", \"signal\": {\"type\": \"offer\", \"sdp\": \"...\"}, \"myCoordinates\": {\"x\": \"250px\", \"y\": \"600px\"}}",
					"outputDataExample": "{\"existingUserID\": \"EXISTING_USER_SOCKET_ID\", \"myID\": \"NEW_USER_SOCKET_ID\", \"signal\": {\"type\": \"offer\", \"sdp\": \"...\"}, \"myCoordinates\": {\"x\": \"250px\", \"y\": \"600px\"}}"
				},
				{
					"simStepId": "4300f1bc-e238-46c7-a2d7-02a713b13809",
					"diagramNodeId": "cc6c977b-b66f-4794-baa1-d21ccbddbb5f",
					"simStepLabel": "Server Relays WebRTC Signal",
					"simStepDescription": "The server acts as a signaling intermediary. It receives the `stream-to-existing-users` event from the new user and forwards the signal payload to the intended recipient (the existing user) by emitting a `user-joined` event.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "36",
						"endLine": "41",
						"relevantVariables": [
							"socket.on",
							"io.to",
							"emit"
						]
					},
					"inputDataExample": "{\"existingUserID\": \"EXISTING_USER_SOCKET_ID\", \"myID\": \"NEW_USER_SOCKET_ID\", \"signal\": {\"type\": \"offer\", \"sdp\": \"...\"}, \"myCoordinates\": {\"x\": \"250px\", \"y\": \"600px\"}}",
					"outputDataExample": "{\"event\": \"user-joined\", \"payload\": {\"signal\": {\"type\": \"offer\", \"sdp\": \"...\"}, \"newUserID\": \"NEW_USER_SOCKET_ID\", \"coordinates\": {\"x\": \"250px\", \"y\": \"600px\"}}}"
				},
				{
					"simStepId": "198091ea-505b-407f-937e-c2c78e8c772c",
					"diagramNodeId": "",
					"simStepLabel": "Server -> Existing Client: 'user-joined' Event",
					"simStepDescription": "The server sends the `user-joined` event to the specific existing user. This payload contains the WebRTC signal from the new user, allowing the existing user to complete the connection handshake.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "37",
						"endLine": "41",
						"relevantVariables": [
							"io.to",
							"emit"
						]
					},
					"inputDataExample": "{\"signal\": {\"type\": \"offer\", \"sdp\": \"...\"}, \"newUserID\": \"NEW_USER_SOCKET_ID\", \"coordinates\": {\"x\": \"250px\", \"y\": \"600px\"}}",
					"outputDataExample": "{\"signal\": {\"type\": \"offer\", \"sdp\": \"...\"}, \"newUserID\": \"NEW_USER_SOCKET_ID\", \"coordinates\": {\"x\": \"250px\", \"y\": \"600px\"}}"
				}
			],
			"description": "<ul><li><em> Users can join a shared session by navigating to a URL with a unique room ID (e</li><li>g</li><li>, <code>/room/:roomID</code>)</li><li></em> Upon joining, the client sends a <code>join-room</code> event to the server, which adds them to the room's roster</li><li><em> The new user receives a list of <code>existing-users</code> to establish video connections with</li><li></em> Simultaneously, existing users are notified of the new participant (<code>user-joined</code> event) to initiate connections back to them</li></ul>",
			"simulationNodesAndEdges": {
