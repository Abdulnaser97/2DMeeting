					"outputDataExample": "{\n  \"existingUserID\": \"EkL8X2fG7H9jP5kDAAAC\",\n  \"myID\": \"J8Dq4eJ3Z5fA6bC7AAAB\",\n  \"signal\": {\n    \"type\": \"offer\",\n    \"sdp\": \"v=0\\r\\no=- 12345 67890 IN IP4 127.0.0.1...\"\n  },\n  \"myCoordinates\": {\n    \"x\": 450,\n    \"y\": 600\n  }\n}"
