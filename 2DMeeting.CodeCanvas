	"simulations": {
		"Real-time Peer-to-Peer Video and Audio Conferencing": {
			"name": "Real-time Peer-to-Peer Video and Audio Conferencing",
			"simSteps": [
				{
					"simStepId": "9ee9c928-c7b9-4de6-9189-696ca7099fbd",
					"diagramNodeId": "a941afe4-5106-45a9-8323-0e45e45a3a13",
					"simStepLabel": "Initialize Media Stream and Connect",
					"simStepDescription": "When the Room component mounts, the client attempts to connect to the Socket.IO server. It then requests access to the user's camera and microphone using `navigator.mediaDevices.getUserMedia`.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "142",
						"endLine": "146",
						"relevantVariables": [
							"socketRef",
							"io.connect",
							"navigator.mediaDevices.getUserMedia",
							"myStream"
						]
					},
					"inputDataExample": "{\n  \"roomID\": \"c7a9a2f1-5e7c-4a3b-8b1e-9f0a2d3c4b5e\"\n}",
					"outputDataExample": "{\n  \"myStream\": \"[MediaStream Object]\",\n  \"socketRef\": \"[Socket.IO Client Object]\"\n}"
				},
				{
					"simStepId": "26fee657-434e-4ece-aeff-95451b7aab8f",
					"diagramNodeId": "9f1f191e-5112-4fef-aa14-eb7666917009",
					"simStepLabel": "API Call: Announce Joining",
					"simStepDescription": "After successfully obtaining the media stream, the client emits a `join-room` event to the server, sending the room ID and its initial coordinates to announce its presence.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "149",
						"endLine": "149",
						"relevantVariables": [
							"socketRef.current.emit"
						]
					},
					"inputDataExample": "{\n  \"roomID\": \"c7a9a2f1-5e7c-4a3b-8b1e-9f0a2d3c4b5e\",\n  \"initialCoordinates\": {\n    \"x\": 450,\n    \"y\": 600\n  }\n}",
					"outputDataExample": "{\n  \"roomID\": \"c7a9a2f1-5e7c-4a3b-8b1e-9f0a2d3c4b5e\",\n  \"initialCoordinates\": {\n    \"x\": 450,\n    \"y\": 600\n  }\n}"
				},
				{
					"simStepId": "4a7b13f0-6ebf-41b8-ae9a-b4753fa319af",
					"diagramNodeId": "7745f121-ae62-449d-bf29-d4dd124a4121",
					"simStepLabel": "Server: Process New User",
					"simStepDescription": "The server's `join-room` listener fires. It registers the new user's socket, adds them to the list of users for that room, and prepares a list of users who are already present.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "14",
						"endLine": "32",
