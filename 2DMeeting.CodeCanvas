					"diagramNodeId": "f576a341-6aa5-49e7-a6a7-6557e3a04175",
					"simStepLabel": "Server -> Client: Emit 'your-welcome-package' Event",
					"simStepDescription": "The server sends a 'your-welcome-package' event back to the originating client. This package contains the client's unique socket ID and confirms the coordinates they will use.",
					"isEdge": 1,
					"sourceCodeMapping": {
