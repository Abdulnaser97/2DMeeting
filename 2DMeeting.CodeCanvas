		"server.js-simstep-4882f697-b9a3-40aa-a8f8-bc337cd6cfd6": {
			"path": "server.js-simstep-4882f697-b9a3-40aa-a8f8-bc337cd6cfd6",
			"fileName": "server.js",
			"wiki": "The server receives the 'join-room' event. It creates a new peer object containing the user's unique socket ID and their coordinates, and then stores this information in an object that maps room IDs to a list of participants.",
			"cellName": "Process New User and Store Coordinates - server.js:L14-21",
			"cellId": "5858b9b7-7703-49e1-9ae0-b8558cf3ca28",
			"visible": true,
