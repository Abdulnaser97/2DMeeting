					"outputDataExample": "{\n  \"componentToRender\": \"Room\",\n  \"props\": {\n    \"match\": {\n      \"params\": {\n        \"roomID\": \"a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d\"\n      }\n    }\n  }\n}"
