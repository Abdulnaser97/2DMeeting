		"Spatial Representation of Participants in a 2D Virtual Room": {
			"name": "Spatial Representation of Participants in a 2D Virtual Room",
			"simSteps": [
				{
					"simStepId": "b883cfd8-0e36-4f81-9732-e56403598fa0",
					"diagramNodeId": "1bf7e9a1-f09f-4eed-a097-06e7ddf6de3b",
					"simStepLabel": "Generate Initial Random Coordinates",
					"simStepDescription": "Before joining the room, the client application calls a utility function to generate random X and Y coordinates for the new participant. These coordinates are determined based on the virtual stage dimensions to ensure the participant appears within bounds.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "45",
						"endLine": "57",
						"relevantVariables": [
							"randomCoordinates",
							"stageWidth",
							"stageHeight",
							"randomXPosition",
							"randomYPosition"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\"x\": 753, \"y\": 421}"
				},
				{
					"simStepId": "212b37d7-85ae-41a3-9dda-bb5131fcd404",
					"diagramNodeId": "98d56caf-63fd-4d9b-8dfd-e68838c30301",
					"simStepLabel": "Transmit Coordinates on Join",
					"simStepDescription": "The client emits a 'join-room' event via WebSocket to the server, sending a payload that includes the target room's ID and the freshly generated initial coordinates for the new user.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "148",
						"endLine": "148",
						"relevantVariables": [
							"socketRef.current.emit",
							"roomID",
							"initialCoordinates"
						]
					},
					"inputDataExample": "{\"roomID\": \"dev-room-123\", \"initialCoordinates\": {\"x\": 753, \"y\": 421}}",
					"outputDataExample": "{\"roomID\": \"dev-room-123\", \"initialCoordinates\": {\"x\": 753, \"y\": 421}}"
				},
				{
					"simStepId": "4882f697-b9a3-40aa-a8f8-bc337cd6cfd6",
					"diagramNodeId": "5858b9b7-7703-49e1-9ae0-b8558cf3ca28",
					"simStepLabel": "Process New User and Store Coordinates",
					"simStepDescription": "The server receives the 'join-room' event. It creates a new peer object containing the user's unique socket ID and their coordinates, and then stores this information in an object that maps room IDs to a list of participants.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "14",
						"endLine": "21",
						"relevantVariables": [
							"socket.on",
							"payload.roomID",
							"payload.initialCoordinates",
							"newPeer",
							"users"
						]
					},
					"inputDataExample": "{\"roomID\": \"dev-room-123\", \"initialCoordinates\": {\"x\": 753, \"y\": 421}}",
					"outputDataExample": "{\"newPeer\": {\"id\": \"_24v-a1b2c3d4e5f\", \"coordinates\": {\"x\": 753, \"y\": 421}}}"
				},
				{
					"simStepId": "a44bb65e-02d6-4678-baf1-0a9cc98faceb",
					"diagramNodeId": "41a459ac-0f2b-4ac6-8e14-1f2486faf2cd",
					"simStepLabel": "Inform Existing Users of New Participant",
					"simStepDescription": "As part of the WebRTC signaling process, the server relays a signal from the new user to existing users in the room. This payload is augmented to include the new user's coordinates, ensuring existing participants know where to place the newcomer.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "37",
						"endLine": "42",
						"relevantVariables": [
							"socket.on('stream-to-existing-users')",
							"io.to",
							"emit('user-joined')",
							"payload.coordinates"
						]
					},
					"inputDataExample": "{\"existingUserID\": \"_f6g-h7i8j9k0l1m\", \"signal\": \"...\", \"myID\": \"_24v-a1b2c3d4e5f\", \"myCoordinates\": {\"x\": 753, \"y\": 421}}",
					"outputDataExample": "{\"signal\": \"...\", \"newUserID\": \"_24v-a1b2c3d4e5f\", \"coordinates\": {\"x\": 753, \"y\": 421}}"
				},
				{
					"simStepId": "f119ac0a-0489-4ea5-8219-47d76717da9f",
					"diagramNodeId": "7b69e99d-6eda-482d-acb9-a3239339900e",
					"simStepLabel": "Receive and Process New User Data",
					"simStepDescription": "An existing user's client receives the 'user-joined' event. It calls the `addPeer` function, passing the signaling data and coordinates of the new user. This function creates a new peer connection and stores the new participant's data, including their position, in the application's state.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "181",
						"endLine": "189",
						"relevantVariables": [
							"socketRef.current.on('user-joined')",
							"addPeer",
							"payload.newUserID",
							"payload.coordinates",
							"peersRef.current"
						]
					},
					"inputDataExample": "{\"signal\": \"...\", \"newUserID\": \"_24v-a1b2c3d4e5f\", \"coordinates\": {\"x\": 753, \"y\": 421}}",
					"outputDataExample": "{\"peerID\": \"_24v-a1b2c3d4e5f\", \"peer\": {\"...\"}}"
				},
				{
					"simStepId": "6c47f86d-6158-45e4-a989-bff1fcd2f54b",
					"diagramNodeId": "759aa3d7-625a-41c4-9cf3-3991efe336c2",
					"simStepLabel": "Pass Peer Coordinates as Props",
					"simStepDescription": "The main `Room` component's render logic iterates over its list of peers. For each peer, it renders a `Video` component, passing the peer's entire data object—which includes their coordinates—as props.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "116",
						"endLine": "122",
						"relevantVariables": [
