		"352fee40-5a3c-4e1c-a52d-ed0ff51d0626": {
			"path": "352fee40-5a3c-4e1c-a52d-ed0ff51d0626",
			"cellName": "Room ID Generation and Redirect - CreateRoom.js:L7-8",
			"cellId": "352fee40-5a3c-4e1c-a52d-ed0ff51d0626",
			"visible": true,
			"parentCellId": "fe38e07b-ff4e-4f9b-8037-5d9d9025390f"
		},
		"client/src/routes/CreateRoom.js-simstep-11701434-7a08-4302-8fc1-872d0756d7ba": {
			"path": "client/src/routes/CreateRoom.js-simstep-11701434-7a08-4302-8fc1-872d0756d7ba",
			"fileName": "CreateRoom.js",
			"wiki": "The 'CreateRoom' component executes. It immediately generates a unique version 1 UUID for the new room and uses the browser's history API to redirect the user to a new URL containing this ID.",
			"cellName": "Room ID Generation and Redirect - CreateRoom.js:L7-8",
			"cellId": "352fee40-5a3c-4e1c-a52d-ed0ff51d0626",
			"visible": true,
			"startLine": 7,
			"endLine": 8,
			"parentCellId": "fe38e07b-ff4e-4f9b-8037-5d9d9025390f",
			"parentPath": "client/src/routes/CreateRoom.js"
		},
		"e191f531-f18a-46ff-9799-f98642d9c782": {
			"path": "e191f531-f18a-46ff-9799-f98642d9c782",
			"cellName": "Route to Room Component - App.js:L12",
			"cellId": "e191f531-f18a-46ff-9799-f98642d9c782",
			"visible": true,
			"parentCellId": "a42a4950-7b26-439a-ae31-19ca3cde26f1"
		},
		"client/src/App.js-simstep-8ca2bf60-8053-4809-8171-600aa7226d13": {
			"path": "client/src/App.js-simstep-8ca2bf60-8053-4809-8171-600aa7226d13",
			"fileName": "App.js",
			"wiki": "The App router now matches the new URL ('/room/:roomID') and maps it to the 'Room' component, passing the room ID from the URL as a parameter.",
			"cellName": "Route to Room Component - App.js:L12",
			"cellId": "e191f531-f18a-46ff-9799-f98642d9c782",
			"visible": true,
			"startLine": 12,
			"endLine": 12,
			"parentCellId": "a42a4950-7b26-439a-ae31-19ca3cde26f1",
			"parentPath": "client/src/App.js"
		},
		"90d39d75-3f34-40cd-b170-d89dcf02d35a": {
			"path": "90d39d75-3f34-40cd-b170-d89dcf02d35a",
			"cellName": "Server Processes 'join-room' - server.js:L13-16",
			"cellId": "90d39d75-3f34-40cd-b170-d89dcf02d35a",
			"visible": true,
			"parentCellId": "c31af4f6-ab55-42b7-bdf4-c3bae3240f04"
		},
		"server.js-simstep-b78f3135-3988-4728-9dac-8a2d7df45862": {
			"path": "server.js-simstep-b78f3135-3988-4728-9dac-8a2d7df45862",
			"fileName": "server.js",
			"wiki": "The server's Socket.IO instance listens for and receives the 'join-room' event. It extracts the payload, creates a new peer object with the client's socket ID and coordinates.",
			"cellName": "Server Processes 'join-room' - server.js:L13-16",
			"cellId": "90d39d75-3f34-40cd-b170-d89dcf02d35a",
			"visible": true,
			"startLine": 13,
			"endLine": 16,
			"parentCellId": "c31af4f6-ab55-42b7-bdf4-c3bae3240f04",
			"parentPath": "server.js"
		},
		"0f17f173-f7ae-4554-8309-760c9dc04d62": {
			"path": "0f17f173-f7ae-4554-8309-760c9dc04d62",
			"cellName": "Server Updates Room State - server.js:L20-26",
			"cellId": "0f17f173-f7ae-4554-8309-760c9dc04d62",
			"visible": true,
			"parentCellId": "c31af4f6-ab55-42b7-bdf4-c3bae3240f04"
		},
		"server.js-simstep-272e24a0-6a26-4583-86ce-a1670fddbac6": {
			"path": "server.js-simstep-272e24a0-6a26-4583-86ce-a1670fddbac6",
			"fileName": "server.js",
			"wiki": "The server adds the new user to its in-memory 'users' object, keyed by the room ID. If the room doesn't exist, it's created. The server also maps the client's socket ID to the room ID for future lookups (like on disconnect).",
			"cellName": "Server Updates Room State - server.js:L20-26",
			"cellId": "0f17f173-f7ae-4554-8309-760c9dc04d62",
			"visible": true,
			"startLine": 20,
			"endLine": 26,
			"parentCellId": "c31af4f6-ab55-42b7-bdf4-c3bae3240f04",
			"parentPath": "server.js"
		},
		"99b6ea7c-1d7e-4c02-b04c-1fbc71b416a7": {
			"path": "99b6ea7c-1d7e-4c02-b04c-1fbc71b416a7",
			"cellName": "Client Receives Room Data and Establishes Peer Connections - Room.js:L146-170",
			"cellId": "99b6ea7c-1d7e-4c02-b04c-1fbc71b416a7",
			"visible": true,
			"parentCellId": "63df3399-6dec-4a79-9180-1feeae987272"
		},
		"client/src/routes/Room.js-simstep-bb112e0d-3269-4f7b-b7eb-3cccc94856d8": {
			"path": "client/src/routes/Room.js-simstep-bb112e0d-3269-4f7b-b7eb-3cccc94856d8",
			"fileName": "Room.js",
			"wiki": "The client receives both the 'your-welcome-package' and 'existing-users' events. It uses the welcome package to set its own state. It then iterates through the list of existing users to initiate WebRTC peer connections with each one.",
			"cellName": "Client Receives Room Data and Establishes Peer Connections - Room.js:L146-170",
			"cellId": "99b6ea7c-1d7e-4c02-b04c-1fbc71b416a7",
