					"outputDataExample": "{\n  \"newUserID\": \"J8Dq4eJ3Z5fA6bC7AAAB\",\n  \"signal\": {\n    \"type\": \"answer\",\n    \"sdp\": \"v=0\\r\\no=- 54321 98765 IN IP4 127.0.0.1...\"\n  }\n}"
