					"simStepLabel": "8. Server -> Client (Existing): Forward Offer",
					"simStepDescription": "The server emits the 'user-joined' event specifically to the existing user's socket, carrying the new user's ID, coordinates, and the WebRTC offer signal.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "37",
						"endLine": "41",
						"relevantVariables": [
