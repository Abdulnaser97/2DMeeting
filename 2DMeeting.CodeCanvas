					"simStepLabel": "4. Server -> Client: Send Welcome Package and User List",
					"simStepDescription": "The server sends two events back to the new user: 'your-welcome-package' with their own peer information, and 'existing-users' with a list of peers already in the room.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "server.js",
