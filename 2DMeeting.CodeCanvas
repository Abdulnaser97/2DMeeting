					"simStepId": "bb112e0d-3269-4f7b-b7eb-3cccc94856d8",
					"diagramNodeId": "99b6ea7c-1d7e-4c02-b04c-1fbc71b416a7",
					"simStepLabel": "Client Receives Room Data and Establishes Peer Connections",
					"simStepDescription": "The client receives both the 'your-welcome-package' and 'existing-users' events. It uses the welcome package to set its own state. It then iterates through the list of existing users to initiate WebRTC peer connections with each one.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "146",
						"endLine": "170",
