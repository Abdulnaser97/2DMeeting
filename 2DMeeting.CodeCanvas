	"simulations": {
		"Real-time P2P Video and Audio Conferencing": {
			"name": "Real-time P2P Video and Audio Conferencing",
			"simSteps": [
				{
					"simStepId": "a8076bff-d06f-43a3-b37f-63e44e5999ba",
					"diagramNodeId": "8837ac92-0f99-462a-826f-5d8878cbee3b",
					"simStepLabel": "1. Client: Initialize and Get Media",
					"simStepDescription": "When a user joins a room, the React component mounts. It initiates a connection to the Socket.IO server and uses `navigator.mediaDevices.getUserMedia` to request access to the user's camera and microphone, creating a local media stream.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "142",
						"endLine": "146",
						"relevantVariables": [
							"socketRef",
							"io.connect",
							"navigator.mediaDevices.getUserMedia"
						]
					},
					"inputDataExample": "{\"roomID\": \"c8b7e6a0-5b6a-4b1e-8e0a-9d2c2f6d7e1b\"}",
					"outputDataExample": "{\"myStream\": \"Instance of MediaStream\"}"
				},
				{
					"simStepId": "1bd5b99a-7c2b-4bfb-bbc8-c108e3b6f5cd",
					"diagramNodeId": "953c611a-2b9b-441f-9fab-0599544ff1c9",
					"simStepLabel": "2. Client -> Server: Emit 'join-room' Event",
					"simStepDescription": "After successfully obtaining the media stream, the client emits a 'join-room' event to the server, sending the unique room ID and its initial coordinates for positioning.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "149",
						"endLine": "149",
						"relevantVariables": [
							"socketRef.current.emit",
							"roomID",
							"initialCoordinates"
						]
					},
					"inputDataExample": "{\"roomID\": \"c8b7e6a0-5b6a-4b1e-8e0a-9d2c2f6d7e1b\", \"initialCoordinates\": {\"x\": 345, \"y\": 678}}",
					"outputDataExample": "{\"roomID\": \"c8b7e6a0-5b6a-4b1e-8e0a-9d2c2f6d7e1b\", \"initialCoordinates\": {\"x\": 345, \"y\": 678}}"
