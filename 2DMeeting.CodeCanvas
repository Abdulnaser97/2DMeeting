					"inputDataExample": "{\n  \"roomID\": \"a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d\",\n  \"initialCoordinates\": {\n    \"x\": \"780px\",\n    \"y\": \"450px\"\n  }\n}",
					"outputDataExample": "{\n  \"roomID\": \"a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d\",\n  \"initialCoordinates\": {\n    \"x\": \"780px\",\n    \"y\": \"450px\"\n  }\n}"
				},
				{
					"simStepId": "b78f3135-3988-4728-9dac-8a2d7df45862",
					"diagramNodeId": "90d39d75-3f34-40cd-b170-d89dcf02d35a",
					"simStepLabel": "Server Processes 'join-room'",
					"simStepDescription": "The server's Socket.IO instance listens for and receives the 'join-room' event. It extracts the payload, creates a new peer object with the client's socket ID and coordinates.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "13",
						"endLine": "16",
						"relevantVariables": [
