					"diagramNodeId": "036f1281-1753-43f4-8143-db8f457a2994",
					"simStepLabel": "3. Server: Handle New User Connection",
					"simStepDescription": "The server listens for the 'join-room' event. It registers the new user with their socket ID, adds them to the specified room, and retrieves a list of any other users already present in that room.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "14",
						"endLine": "32",
