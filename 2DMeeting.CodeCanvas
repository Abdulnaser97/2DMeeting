		"a6113d06-f109-4f42-8ddc-8a02175540ce": {
			"path": "a6113d06-f109-4f42-8ddc-8a02175540ce",
			"cellName": "Room.js",
			"cellId": "a6113d06-f109-4f42-8ddc-8a02175540ce",
			"visible": true,
			"parentCellId": "bed28dfe-3670-418b-8428-8ed98ea7a9fe"
		},
		"8837ac92-0f99-462a-826f-5d8878cbee3b": {
			"path": "8837ac92-0f99-462a-826f-5d8878cbee3b",
			"cellName": "1. Client: Initialize and Get Media - Room.js:L142-146",
			"cellId": "8837ac92-0f99-462a-826f-5d8878cbee3b",
			"visible": true,
			"parentCellId": "a6113d06-f109-4f42-8ddc-8a02175540ce"
		},
		"client/src/routes/Room.js-simstep-a8076bff-d06f-43a3-b37f-63e44e5999ba": {
			"path": "client/src/routes/Room.js-simstep-a8076bff-d06f-43a3-b37f-63e44e5999ba",
			"fileName": "Room.js",
			"wiki": "When a user joins a room, the React component mounts. It initiates a connection to the Socket.IO server and uses `navigator.mediaDevices.getUserMedia` to request access to the user's camera and microphone, creating a local media stream.",
			"cellName": "1. Client: Initialize and Get Media - Room.js:L142-146",
			"cellId": "8837ac92-0f99-462a-826f-5d8878cbee3b",
			"visible": true,
			"startLine": 142,
			"endLine": 146,
			"parentCellId": "a6113d06-f109-4f42-8ddc-8a02175540ce",
			"parentPath": "client/src/routes/Room.js"
		},
		"036f1281-1753-43f4-8143-db8f457a2994": {
			"path": "036f1281-1753-43f4-8143-db8f457a2994",
			"cellName": "3. Server: Handle New User Connection - server.js:L14-32",
			"cellId": "036f1281-1753-43f4-8143-db8f457a2994",
			"visible": true,
			"parentCellId": "5bb9d807-3e54-44ac-bf11-b267785ea0f8"
		},
		"server.js-simstep-4d11d63a-7392-465b-9825-38d0f9617135": {
			"path": "server.js-simstep-4d11d63a-7392-465b-9825-38d0f9617135",
			"fileName": "server.js",
			"wiki": "The server listens for the 'join-room' event. It registers the new user with their socket ID, adds them to the specified room, and retrieves a list of any other users already present in that room.",
			"cellName": "3. Server: Handle New User Connection - server.js:L14-32",
			"cellId": "036f1281-1753-43f4-8143-db8f457a2994",
			"visible": true,
			"startLine": 14,
			"endLine": 32,
			"parentCellId": "5bb9d807-3e54-44ac-bf11-b267785ea0f8",
			"parentPath": "server.js"
		},
		"6457abbb-8389-4b3c-8dc8-cfd224f3d7fd": {
			"path": "6457abbb-8389-4b3c-8dc8-cfd224f3d7fd",
			"cellName": "5. Client: Create Initiator Peer - Room.js:L231-237",
			"cellId": "6457abbb-8389-4b3c-8dc8-cfd224f3d7fd",
			"visible": true,
			"parentCellId": "a6113d06-f109-4f42-8ddc-8a02175540ce"
		},
		"client/src/routes/Room.js-simstep-3d12f000-5c69-4a7e-80aa-a9670a5d699e": {
			"path": "client/src/routes/Room.js-simstep-3d12f000-5c69-4a7e-80aa-a9670a5d699e",
			"fileName": "Room.js",
			"wiki": "Upon receiving the list of existing users, the new user's client iterates through it. For each existing user, it creates a `simple-peer` instance with `initiator: true` to begin the WebRTC connection handshake.",
			"cellName": "5. Client: Create Initiator Peer - Room.js:L231-237",
			"cellId": "6457abbb-8389-4b3c-8dc8-cfd224f3d7fd",
			"visible": true,
			"startLine": 231,
			"endLine": 237,
			"parentCellId": "a6113d06-f109-4f42-8ddc-8a02175540ce",
			"parentPath": "client/src/routes/Room.js"
		},
		"f40c5225-2a25-4d6f-aaa1-f1f2f1de0068": {
			"path": "f40c5225-2a25-4d6f-aaa1-f1f2f1de0068",
			"cellName": "7. Server: Relay Offer Signal - server.js:L36-41",
			"cellId": "f40c5225-2a25-4d6f-aaa1-f1f2f1de0068",
			"visible": true,
			"parentCellId": "5bb9d807-3e54-44ac-bf11-b267785ea0f8"
		},
		"server.js-simstep-ec6e07b3-91e0-4964-89c5-eb3327d9424c": {
			"path": "server.js-simstep-ec6e07b3-91e0-4964-89c5-eb3327d9424c",
			"fileName": "server.js",
			"wiki": "The server acts as a signaling relay. It receives the 'stream-to-existing-users' event and forwards the WebRTC offer signal to the intended recipient (the existing user) using a 'user-joined' event.",
			"cellName": "7. Server: Relay Offer Signal - server.js:L36-41",
			"cellId": "f40c5225-2a25-4d6f-aaa1-f1f2f1de0068",
			"visible": true,
			"startLine": 36,
			"endLine": 41,
			"parentCellId": "5bb9d807-3e54-44ac-bf11-b267785ea0f8",
			"parentPath": "server.js"
		},
		"c6628a8e-8190-4020-b297-18c0b47d3b00": {
			"path": "c6628a8e-8190-4020-b297-18c0b47d3b00",
			"cellName": "9. Client (Existing): Create Receiver Peer and Answer - Room.js:L256-262",
			"cellId": "c6628a8e-8190-4020-b297-18c0b47d3b00",
			"visible": true,
			"parentCellId": "a6113d06-f109-4f42-8ddc-8a02175540ce"
		},
		"client/src/routes/Room.js-simstep-b24cb8d6-869d-47e2-9314-8e9d3e2e3f01": {
			"path": "client/src/routes/Room.js-simstep-b24cb8d6-869d-47e2-9314-8e9d3e2e3f01",
			"fileName": "Room.js",
			"wiki": "The existing user's client receives the 'user-joined' event. It creates a non-initiator (`initiator: false`) peer, accepts the incoming offer signal, and generates an answer signal in response.",
			"cellName": "9. Client (Existing): Create Receiver Peer and Answer - Room.js:L256-262",
			"cellId": "c6628a8e-8190-4020-b297-18c0b47d3b00",
			"visible": true,
			"startLine": 256,
			"endLine": 262,
			"parentCellId": "a6113d06-f109-4f42-8ddc-8a02175540ce",
			"parentPath": "client/src/routes/Room.js"
		},
		"7d9af7ba-72ca-412d-b4aa-916eb21a5315": {
			"path": "7d9af7ba-72ca-412d-b4aa-916eb21a5315",
			"cellName": "11. Server: Relay Answer Signal - server.js:L44-52",
			"cellId": "7d9af7ba-72ca-412d-b4aa-916eb21a5315",
			"visible": true,
			"parentCellId": "5bb9d807-3e54-44ac-bf11-b267785ea0f8"
		},
		"server.js-simstep-f934a346-1f0e-42d7-a92b-3ab11ec9728e": {
			"path": "server.js-simstep-f934a346-1f0e-42d7-a92b-3ab11ec9728e",
			"fileName": "server.js",
			"wiki": "The server receives the 'returning-signal-to-new-users' event and relays the answer signal to the new user via a 'receiving-returned-signal-from-existing-user' event.",
			"cellName": "11. Server: Relay Answer Signal - server.js:L44-52",
			"cellId": "7d9af7ba-72ca-412d-b4aa-916eb21a5315",
			"visible": true,
			"startLine": 44,
			"endLine": 52,
			"parentCellId": "5bb9d807-3e54-44ac-bf11-b267785ea0f8",
			"parentPath": "server.js"
		},
		"6308243f-b46e-47a1-947f-cfb9cc2d63bc": {
			"path": "6308243f-b46e-47a1-947f-cfb9cc2d63bc",
			"cellName": "13. Client (New): Finalize Connection - Room.js:L231-240",
			"cellId": "6308243f-b46e-47a1-947f-cfb9cc2d63bc",
			"visible": true,
			"parentCellId": "a6113d06-f109-4f42-8ddc-8a02175540ce"
		},
		"client/src/routes/Room.js-simstep-451f5c18-0e73-4a9d-b438-58516db8a712": {
			"path": "client/src/routes/Room.js-simstep-451f5c18-0e73-4a9d-b438-58516db8a712",
			"fileName": "Room.js",
			"wiki": "The new user's client receives the answer signal and passes it to the corresponding `simple-peer` instance. This completes the WebRTC handshake, and a direct P2P connection is now established.",
			"cellName": "13. Client (New): Finalize Connection - Room.js:L231-240",
			"cellId": "6308243f-b46e-47a1-947f-cfb9cc2d63bc",
			"visible": true,
			"startLine": 231,
			"endLine": 240,
			"parentCellId": "a6113d06-f109-4f42-8ddc-8a02175540ce",
			"parentPath": "client/src/routes/Room.js"
		},
		"92da4c5a-cd26-4b23-ad9c-1d4226318648": {
			"path": "92da4c5a-cd26-4b23-ad9c-1d4226318648",
			"cellName": "15. Client: Render Remote Video - Room.js:L110-112",
			"cellId": "92da4c5a-cd26-4b23-ad9c-1d4226318648",
			"visible": true,
			"parentCellId": "a6113d06-f109-4f42-8ddc-8a02175540ce"
		},
		"client/src/routes/Room.js-simstep-97019558-c9c8-40c1-8790-d7b91e1c8273": {
			"path": "client/src/routes/Room.js-simstep-97019558-c9c8-40c1-8790-d7b91e1c8273",
			"fileName": "Room.js",
			"wiki": "Both clients listen for the 'stream' event from the peer object. When a remote stream is received, it's attached to the `srcObject` of a `<video>` element, making the other user visible and audible.",
			"cellName": "15. Client: Render Remote Video - Room.js:L110-112",
			"cellId": "92da4c5a-cd26-4b23-ad9c-1d4226318648",
			"visible": true,
			"startLine": 110,
			"endLine": 112,
			"parentCellId": "a6113d06-f109-4f42-8ddc-8a02175540ce",
			"parentPath": "client/src/routes/Room.js"
		},
