							"socketRef.current.emit(\"stream-to-existing-users\")"
						]
					},
					"inputDataExample": "{\"existingUserID\": \"existing_user_socket_id\", \"myID\": \"new_user_socket_id\", \"signal\": {\"type\": \"offer\", \"sdp\": \"...\"}, \"myCoordinates\": {\"x\": 345, \"y\": 678}}",
					"outputDataExample": "{\"existingUserID\": \"existing_user_socket_id\", \"myID\": \"new_user_socket_id\", \"signal\": {\"type\": \"offer\", \"sdp\": \"...\"}, \"myCoordinates\": {\"x\": 345, \"y\": 678}}"
				},
				{
					"simStepId": "ec6e07b3-91e0-4964-89c5-eb3327d9424c",
					"diagramNodeId": "f40c5225-2a25-4d6f-aaa1-f1f2f1de0068",
					"simStepLabel": "7. Server: Relay Offer Signal",
					"simStepDescription": "The server acts as a signaling relay. It receives the 'stream-to-existing-users' event and forwards the WebRTC offer signal to the intended recipient (the existing user) using a 'user-joined' event.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "36",
						"endLine": "41",
						"relevantVariables": [
