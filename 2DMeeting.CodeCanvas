					},
					"inputDataExample": "{\"signal\": {\"type\": \"offer\", \"sdp\": \"...\"}, \"newUserID\": \"new_user_socket_id\", \"coordinates\": {\"x\": 345, \"y\": 678}}",
					"outputDataExample": "{\"signal\": {\"type\": \"offer\", \"sdp\": \"...\"}, \"newUserID\": \"new_user_socket_id\", \"coordinates\": {\"x\": 345, \"y\": 678}}"
				},
				{
					"simStepId": "b24cb8d6-869d-47e2-9314-8e9d3e2e3f01",
					"diagramNodeId": "c6628a8e-8190-4020-b297-18c0b47d3b00",
					"simStepLabel": "9. Client (Existing): Create Receiver Peer and Answer",
					"simStepDescription": "The existing user's client receives the 'user-joined' event. It creates a non-initiator (`initiator: false`) peer, accepts the incoming offer signal, and generates an answer signal in response.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "256",
						"endLine": "262",
						"relevantVariables": [
							"Peer",
							"initiator",
							"stream",
							"peer.signal(incomingSignal)"
						]
					},
					"inputDataExample": "{\"signal\": {\"type\": \"offer\", \"sdp\": \"...\"}, \"newUserID\": \"new_user_socket_id\"}",
					"outputDataExample": "{\"signal\": {\"type\": \"answer\", \"sdp\": \"...\"}}"
				},
				{
					"simStepId": "471b4c08-43f2-433a-92d8-a004da0c096e",
					"diagramNodeId": "92c729ac-8b44-4459-b0c3-9f805030f8a0",
					"simStepLabel": "10. Client (Existing) -> Server: Send WebRTC Answer Signal",
					"simStepDescription": "The existing user's client sends the generated answer signal back to the server via a 'returning-signal-to-new-users' event, targeting the new user who initiated the connection.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "server.js",
						"startLine": "44",
						"endLine": "52",
						"relevantVariables": [
