		},
		"a941afe4-5106-45a9-8323-0e45e45a3a13": {
			"path": "a941afe4-5106-45a9-8323-0e45e45a3a13",
			"cellName": "Initialize Media Stream and Connect - Room.js:L142-146",
			"cellId": "a941afe4-5106-45a9-8323-0e45e45a3a13",
			"visible": true,
			"parentCellId": "63df3399-6dec-4a79-9180-1feeae987272"
		},
		"client/src/routes/Room.js-simstep-9ee9c928-c7b9-4de6-9189-696ca7099fbd": {
			"path": "client/src/routes/Room.js-simstep-9ee9c928-c7b9-4de6-9189-696ca7099fbd",
			"fileName": "Room.js",
			"wiki": "When the Room component mounts, the client attempts to connect to the Socket.IO server. It then requests access to the user's camera and microphone using `navigator.mediaDevices.getUserMedia`.",
			"cellName": "Initialize Media Stream and Connect - Room.js:L142-146",
			"cellId": "a941afe4-5106-45a9-8323-0e45e45a3a13",
			"visible": true,
			"startLine": 142,
			"endLine": 146,
			"parentCellId": "63df3399-6dec-4a79-9180-1feeae987272",
			"parentPath": "client/src/routes/Room.js"
		},
		"7745f121-ae62-449d-bf29-d4dd124a4121": {
			"path": "7745f121-ae62-449d-bf29-d4dd124a4121",
			"cellName": "Server: Process New User - server.js:L14-32",
			"cellId": "7745f121-ae62-449d-bf29-d4dd124a4121",
			"visible": true,
			"parentCellId": "c31af4f6-ab55-42b7-bdf4-c3bae3240f04"
		},
		"server.js-simstep-4a7b13f0-6ebf-41b8-ae9a-b4753fa319af": {
			"path": "server.js-simstep-4a7b13f0-6ebf-41b8-ae9a-b4753fa319af",
			"fileName": "server.js",
			"wiki": "The server's `join-room` listener fires. It registers the new user's socket, adds them to the list of users for that room, and prepares a list of users who are already present.",
			"cellName": "Server: Process New User - server.js:L14-32",
			"cellId": "7745f121-ae62-449d-bf29-d4dd124a4121",
			"visible": true,
			"startLine": 14,
			"endLine": 32,
			"parentCellId": "c31af4f6-ab55-42b7-bdf4-c3bae3240f04",
			"parentPath": "server.js"
		},
		"870e7490-0774-4af4-aa78-7b07be3c9641": {
			"path": "870e7490-0774-4af4-aa78-7b07be3c9641",
			"cellName": "Client: Initiate Peer Connection (Offer) - Room.js:L232-240",
			"cellId": "870e7490-0774-4af4-aa78-7b07be3c9641",
			"visible": true,
			"parentCellId": "63df3399-6dec-4a79-9180-1feeae987272"
		},
		"client/src/routes/Room.js-simstep-6e74a24e-6ffc-4a2d-8687-881bd41fdbf0": {
			"path": "client/src/routes/Room.js-simstep-6e74a24e-6ffc-4a2d-8687-881bd41fdbf0",
			"fileName": "Room.js",
			"wiki": "The new client receives the list of existing users. It then creates a new `Peer` object for each one with `initiator: true`. This automatically generates a WebRTC offer signal needed to start a peer connection.",
			"cellName": "Client: Initiate Peer Connection (Offer) - Room.js:L232-240",
			"cellId": "870e7490-0774-4af4-aa78-7b07be3c9641",
			"visible": true,
			"startLine": 232,
			"endLine": 240,
			"parentCellId": "63df3399-6dec-4a79-9180-1feeae987272",
			"parentPath": "client/src/routes/Room.js"
		},
		"5a164063-9a04-4b6c-a167-c3c7fee08dbe": {
			"path": "5a164063-9a04-4b6c-a167-c3c7fee08dbe",
			"cellName": "Server: Forward Offer Signal - server.js:L36-42",
			"cellId": "5a164063-9a04-4b6c-a167-c3c7fee08dbe",
			"visible": true,
			"parentCellId": "c31af4f6-ab55-42b7-bdf4-c3bae3240f04"
		},
		"server.js-simstep-18f0b8d1-9c06-4fbd-98c9-28c8a31702df": {
			"path": "server.js-simstep-18f0b8d1-9c06-4fbd-98c9-28c8a31702df",
			"fileName": "server.js",
			"wiki": "The server receives the `stream-to-existing-users` event. It acts as a signaling server, forwarding the offer signal to the specified existing user via a `user-joined` event.",
			"cellName": "Server: Forward Offer Signal - server.js:L36-42",
			"cellId": "5a164063-9a04-4b6c-a167-c3c7fee08dbe",
			"visible": true,
			"startLine": 36,
			"endLine": 42,
			"parentCellId": "c31af4f6-ab55-42b7-bdf4-c3bae3240f04",
			"parentPath": "server.js"
		},
		"16dc9fc6-1650-4b51-aec4-ef48eb5cc01d": {
			"path": "16dc9fc6-1650-4b51-aec4-ef48eb5cc01d",
			"cellName": "Existing Client: Create Peer Connection (Answer) - Room.js:L256-264",
			"cellId": "16dc9fc6-1650-4b51-aec4-ef48eb5cc01d",
			"visible": true,
			"parentCellId": "63df3399-6dec-4a79-9180-1feeae987272"
		},
		"client/src/routes/Room.js-simstep-d29d070f-f816-4fbf-97eb-901ba2dc7708": {
			"path": "client/src/routes/Room.js-simstep-d29d070f-f816-4fbf-97eb-901ba2dc7708",
			"fileName": "Room.js",
			"wiki": "The existing user's client receives the `user-joined` event. It creates a new `Peer` object with `initiator: false`, processes the offer, and generates a WebRTC answer signal to send back.",
			"cellName": "Existing Client: Create Peer Connection (Answer) - Room.js:L256-264",
			"cellId": "16dc9fc6-1650-4b51-aec4-ef48eb5cc01d",
			"visible": true,
			"startLine": 256,
			"endLine": 264,
			"parentCellId": "63df3399-6dec-4a79-9180-1feeae987272",
			"parentPath": "client/src/routes/Room.js"
		},
		"061a7300-c308-4bc9-b441-9a9f0cf087f7": {
			"path": "061a7300-c308-4bc9-b441-9a9f0cf087f7",
			"cellName": "Server: Forward Answer Signal - server.js:L44-52",
			"cellId": "061a7300-c308-4bc9-b441-9a9f0cf087f7",
			"visible": true,
			"parentCellId": "c31af4f6-ab55-42b7-bdf4-c3bae3240f04"
		},
		"server.js-simstep-21c89ef8-13dd-461f-bfed-3fb961c64e5c": {
			"path": "server.js-simstep-21c89ef8-13dd-461f-bfed-3fb961c64e5c",
			"fileName": "server.js",
			"wiki": "The server receives the answer signal and forwards it to the new user who initiated the connection.",
			"cellName": "Server: Forward Answer Signal - server.js:L44-52",
			"cellId": "061a7300-c308-4bc9-b441-9a9f0cf087f7",
			"visible": true,
			"startLine": 44,
			"endLine": 52,
			"parentCellId": "c31af4f6-ab55-42b7-bdf4-c3bae3240f04",
			"parentPath": "server.js"
		},
		"6fc92595-4114-41d1-9ca8-46f1c4f36fb8": {
			"path": "6fc92595-4114-41d1-9ca8-46f1c4f36fb8",
			"cellName": "Connection Established and Stream Received - Room.js:L110-112",
			"cellId": "6fc92595-4114-41d1-9ca8-46f1c4f36fb8",
			"visible": true,
			"parentCellId": "63df3399-6dec-4a79-9180-1feeae987272"
		},
		"client/src/routes/Room.js-simstep-2546a6cb-ecd4-4a63-9439-4b1c8f6a586d": {
			"path": "client/src/routes/Room.js-simstep-2546a6cb-ecd4-4a63-9439-4b1c8f6a586d",
			"fileName": "Room.js",
			"wiki": "The new user's client receives the answer and finalizes the peer connection. Once the WebRTC connection is established, the `stream` event fires on the peer object, providing the remote user's media stream.",
			"cellName": "Connection Established and Stream Received - Room.js:L110-112",
			"cellId": "6fc92595-4114-41d1-9ca8-46f1c4f36fb8",
			"visible": true,
			"startLine": 110,
			"endLine": 112,
			"parentCellId": "63df3399-6dec-4a79-9180-1feeae987272",
			"parentPath": "client/src/routes/Room.js"
		},
		"9f1f191e-5112-4fef-aa14-eb7666917009": {
			"path": "9f1f191e-5112-4fef-aa14-eb7666917009",
