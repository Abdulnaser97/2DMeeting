					"diagramNodeId": "16e5b6d0-d1a2-450b-9138-4d5d1767f1db",
					"simStepLabel": "API Call: Send List of Existing Users",
					"simStepDescription": "The server emits an `existing-users` event back to the newly connected client, providing the list of peers already in the room.",
					"isEdge": 1,
