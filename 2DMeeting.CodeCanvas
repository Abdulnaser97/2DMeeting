		"client/src/routes/Room.js-simstep-f119ac0a-0489-4ea5-8219-47d76717da9f": {
			"path": "client/src/routes/Room.js-simstep-f119ac0a-0489-4ea5-8219-47d76717da9f",
			"fileName": "Room.js",
			"wiki": "An existing user's client receives the 'user-joined' event. It calls the `addPeer` function, passing the signaling data and coordinates of the new user. This function creates a new peer connection and stores the new participant's data, including their position, in the application's state.",
			"cellName": "Receive and Process New User Data - Room.js:L181-189",
			"cellId": "7b69e99d-6eda-482d-acb9-a3239339900e",
			"visible": true,
			"startLine": 181,
			"endLine": 189,
			"parentCellId": "a6113d06-f109-4f42-8ddc-8a02175540ce",
			"parentPath": "client/src/routes/Room.js"
		},
		"9fe45e29-d23a-4a98-b396-cbc01014db80": {
			"path": "9fe45e29-d23a-4a98-b396-cbc01014db80",
