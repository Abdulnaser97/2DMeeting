					},
					"inputDataExample": "{\"welcomePackage\": {\"id\": \"new_user_socket_id\", \"coordinates\": {\"x\": 345, \"y\": 678}}, \"existingUsers\": [{\"id\": \"existing_user_socket_id\", \"coordinates\": {\"x\": 123, \"y\": 456}}]}",
					"outputDataExample": "{\"welcomePackage\": {\"id\": \"new_user_socket_id\", \"coordinates\": {\"x\": 345, \"y\": 678}}, \"existingUsers\": [{\"id\": \"existing_user_socket_id\", \"coordinates\": {\"x\": 123, \"y\": 456}}]}"
				},
				{
					"simStepId": "3d12f000-5c69-4a7e-80aa-a9670a5d699e",
					"diagramNodeId": "6457abbb-8389-4b3c-8dc8-cfd224f3d7fd",
					"simStepLabel": "5. Client: Create Initiator Peer",
					"simStepDescription": "Upon receiving the list of existing users, the new user's client iterates through it. For each existing user, it creates a `simple-peer` instance with `initiator: true` to begin the WebRTC connection handshake.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "231",
						"endLine": "237",
						"relevantVariables": [
							"Peer",
							"initiator",
							"stream"
						]
					},
					"inputDataExample": "{\"users\": [{\"id\": \"existing_user_socket_id\", \"coordinates\": {\"x\": 123, \"y\": 456}}]}",
					"outputDataExample": "{\"peer\": \"Instance of simple-peer with initiator set to true\"}"
				},
				{
					"simStepId": "94834621-79a5-4063-8e5d-e2e617e6d9f9",
					"diagramNodeId": "f84aa896-9e59-4464-bd71-319710364be1",
					"simStepLabel": "6. Client -> Server: Send WebRTC Offer Signal",
					"simStepDescription": "The newly created `simple-peer` instance automatically generates a 'signal' (a WebRTC offer). The client sends this offer to the server via the 'stream-to-existing-users' event, targeting a specific existing user.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "client/src/routes/Room.js",
						"startLine": "240",
						"endLine": "245",
						"relevantVariables": [
